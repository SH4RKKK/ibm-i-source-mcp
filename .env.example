# Copy to .env. See the Configuration section of the README for where this file
# is searched for and how to add more servers.

IBMI_HOST=ibmi.example.com
IBMI_USER=MYUSER
IBMI_PASSWORD=changeme

# optional
IBMI_SSH_PORT=22               # ssh port on the box
IBMI_SOURCE_FILE_CCSID=37      # ebcdic page to read ccsid 65535 columns as
IBMI_LOCAL_DIR=ibmi-src        # where local copies are written
IBMI_MAPEPIRE_JAR=             # a jar already on the box, instead of the bundled one
IBMI_READ_ONLY=false           # true blocks upload, compile and library list changes
IBMI_BLOCKED_CL=               # extra cl commands compile_member must refuse
